{
  "name": "@olegkoval/agent-skills",
  "version": "1.41.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Agent-agnostic skill catalog for Codex, Claude, Cursor, Grok, Copilot, Windsurf, Kiro, and other skill-aware tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleg-koval/agent-skills.git"
  },
  "bugs": {
    "url": "https://github.com/oleg-koval/agent-skills/issues"
  },
  "homepage": "https://github.com/oleg-koval/agent-skills#readme",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "plugins",
    "adapters",
    "catalog",
    "docs",
    ".claude-plugin",
    ".cursor-plugin",
    ".grok-plugin",
    ".windsurf",
    ".kiro",
    ".github/prompts",
    ".github/copilot-instructions.md",
    "scripts",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "site"
  ],
  "scripts": {
    "build": "sh ./scripts/build-adapters.sh",
    "validate": "node .github/scripts/check-frontmatter.mjs . && ./scripts/validate-catalog.sh",
    "test": "node .github/scripts/check-frontmatter.mjs --test && npm run validate && for t in tests/test-*.sh; do sh \"$t\" || exit 1; done",
    "semantic-release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci --verify-conditions=@semantic-release/changelog --verify-conditions=@semantic-release/git --verify-conditions=@semantic-release/github",
    "build:site": "node site/build.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^25.0.3",
    "semantic-release-npm-github-publish": "^1.7.3"
  }
}
