#!/usr/bin/env bash
# Toolchain check for Connect IQ development.
#
# The SDK ships no JDK and Homebrew's openjdk is keg-only, so neither is on PATH
# by default. The SDK also lives under "Application Support" -- a path with a
# space, which make's direct-exec lookup mishandles. Both produce confusing
# errors well after the point where they went wrong.

set -uo pipefail

CIQ="$HOME/Library/Application Support/Garmin/ConnectIQ"
KEY="${CIQ_KEY:-$HOME/.Garmin/ConnectIQ/developer_key.der}"
DEVICE="${1:-fenix6pro}"
fail=0

ok()   { printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad()  { printf '  \033[31mMISS\033[0m  %s\n' "$1"; fail=1; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }

echo "Connect IQ toolchain"

JDK="$(brew --prefix openjdk 2>/dev/null)/libexec/openjdk.jdk/Contents/Home"
if [ -x "$JDK/bin/java" ]; then
  ok "jdk       $("$JDK/bin/java" -version 2>&1 | head -1)"
elif command -v java >/dev/null 2>&1; then
  warn "jdk       using PATH java: $(java -version 2>&1 | head -1)"
else
  bad "jdk       install with: brew install openjdk"
fi

if [ -f "$CIQ/current-sdk.cfg" ]; then
  SDK="$(tr -d '\n' < "$CIQ/current-sdk.cfg")"
  ok "sdk       $(basename "$SDK")"
else
  bad "sdk       no current-sdk.cfg -- open SdkManager.app and select an SDK"
  SDK=""
fi

for tool in monkeyc monkeydo connectiq; do
  if [ -n "$SDK" ] && [ -x "${SDK}bin/$tool" ]; then
    ok "$tool"
  else
    bad "$tool    not found under \${SDK}bin/"
  fi
done

if [ -f "$KEY" ]; then
  ok "key       $KEY"
else
  bad "key       missing -- run 'make key' (never commit it)"
fi

if [ -d "$CIQ/Devices/$DEVICE" ]; then
  ok "device    $DEVICE"
else
  bad "device    $DEVICE not installed -- add it in SdkManager.app"
fi

COUNT=$(ls "$CIQ/Devices" 2>/dev/null | wc -l | tr -d ' ')
echo "  info  $COUNT device(s) installed"

if python3 -c "import PIL" 2>/dev/null; then
  ok "pillow    (needed by ciq-capture --face)"
else
  warn "pillow    missing -- pip install pillow, for screenshot cropping"
fi

echo
if [ -f monkey.jungle ]; then
  echo "Project checks"
  if grep -q "excludeAnnotations" monkey.jungle 2>/dev/null; then
    if [ -f monkey.test.jungle ]; then
      ok "tests     monkey.test.jungle present"
    else
      bad "tests     monkey.jungle excludes 'test' annotations and there is no"
      printf '        monkey.test.jungle -- your test suite compiles to NOTHING\n'
      printf '        and reports success. See the skill README.\n'
    fi
  fi
  if [ -d .git ] && git ls-files --error-unmatch "$KEY" >/dev/null 2>&1; then
    bad "key       DEVELOPER KEY IS TRACKED IN GIT -- remove it now"
  fi
fi

exit $fail
