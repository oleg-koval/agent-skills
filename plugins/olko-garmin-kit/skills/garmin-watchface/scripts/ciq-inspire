#!/usr/bin/env python3
"""Pull design inspiration from open APIs and turn it into device-truthful
design tokens.

    ciq-inspire --brand garmin.com              # Brandfetch: colours, fonts
    ciq-inspire --image ~/crest.png             # dominant colours from a file
    ciq-inspire --prior-art "chronograph"       # GitHub: Monkey C faces to read
    ciq-inspire --brand acme.com --json tokens.json

Every colour that comes back is quantized to the 4x4x4 lattice and ranked by
reflectance BEFORE you see it. A palette approved in its source form is a
palette that changes the moment it reaches the watch, and the change is never
small: an off-lattice mid-grey and an off-lattice pale grey routinely collapse
onto the same value.

Sources, and what each is actually good for
-------------------------------------------

  Brandfetch   https://brandfetch.com -- brand colours and typeface names for a
               domain. Set BRANDFETCH_API_KEY. Free tier is enough.
  GitHub       prior art: real Monkey C sources you can read for how a thing was
               drawn. Uses `gh` when installed (higher rate limit), else
               unauthenticated HTTP.
  Local image  dominant colours from a logo, crest or reference photo. Needs
               Pillow, which the screenshot tooling already requires.

There is NO public Connect IQ Store API. Store research is manual.

IP, and this is not optional
----------------------------

Brandfetch will happily hand you another company's colours, wordmark and logo.
Colours and proportions are fine to be inspired by. Marks are not: the Connect
IQ store rejects, and Garmin removes, faces carrying a third party's name or
logo in the face, the icon, the screenshots or the copy. Use --brand for a
domain you own, or for palette study only. See references/store.md.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

LEVELS = (0x00, 0x55, 0xAA, 0xFF)
UA = "ciq-inspire (Connect IQ design tooling)"


def quantize(rgb):
    return tuple(min(LEVELS, key=lambda level: abs(level - c)) for c in rgb)


def hexof(rgb):
    return "#%02X%02X%02X" % rgb


def luminance(rgb):
    r, g, b = rgb
    return (r * 299 + g * 587 + b * 114) // 1000


def parse_hex(text):
    t = (text or "").strip().lstrip("#")
    if len(t) == 3:
        t = "".join(c * 2 for c in t)
    if len(t) != 6:
        return None
    try:
        return tuple(int(t[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return None


def get(url, headers=None):
    req = urllib.request.Request(url, headers={"User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read().decode("utf-8"))


# ------------------------------------------------------------- brandfetch ----

def from_brandfetch(domain):
    key = os.environ.get("BRANDFETCH_API_KEY")
    if not key:
        print("BRANDFETCH_API_KEY is not set. Get a free key at "
              "https://developers.brandfetch.com and export it.", file=sys.stderr)
        return None
    url = f"https://api.brandfetch.io/v2/brands/{urllib.parse.quote(domain)}"
    try:
        data = get(url, {"Authorization": f"Bearer {key}"})
    except urllib.error.HTTPError as exc:
        print(f"Brandfetch {exc.code} for {domain}: {exc.reason}", file=sys.stderr)
        return None
    except urllib.error.URLError as exc:
        print(f"Brandfetch unreachable: {exc.reason}", file=sys.stderr)
        return None

    colours = []
    for c in data.get("colors") or []:
        rgb = parse_hex(c.get("hex"))
        if rgb:
            colours.append({"rgb": rgb, "role": c.get("type") or "unknown"})

    fonts = [f.get("name") for f in (data.get("fonts") or []) if f.get("name")]
    return {
        "source": f"brandfetch:{domain}",
        "name": data.get("name") or domain,
        "colours": colours,
        # Recorded for tone only. No system font on the watch is any of these,
        # and a segment display has to be drawn rather than typeset.
        "typefaces": fonts,
    }


# ------------------------------------------------------------------ image ----

def from_image(path, count):
    try:
        from PIL import Image
    except ImportError:
        print("Pillow is required for --image: python3 -m pip install Pillow",
              file=sys.stderr)
        return None
    if not Path(path).is_file():
        print(f"No such file: {path}", file=sys.stderr)
        return None

    img = Image.open(path).convert("RGB")
    img.thumbnail((160, 160))
    # Quantize FIRST, then count. Counting true colours and quantizing after
    # returns near-duplicates that collapse into one value on the panel and
    # makes a two-colour logo look like a six-colour palette.
    # Raw bytes rather than getdata(): getdata() is deprecated in Pillow 14 and
    # tobytes() has meant the same thing in every version.
    raw = img.tobytes()
    tally = {}
    for i in range(0, len(raw) - 2, 3):
        q = quantize(raw[i:i + 3])
        tally[q] = tally.get(q, 0) + 1
    total = sum(tally.values())
    ranked = sorted(tally.items(), key=lambda kv: -kv[1])[:count]
    return {
        "source": f"image:{Path(path).name}",
        "name": Path(path).stem,
        "colours": [{"rgb": rgb, "role": f"{(n * 100) // total}% of pixels"}
                    for rgb, n in ranked],
        "typefaces": [],
    }


# ---------------------------------------------------------------- github ----

def gh_search(query, limit):
    """Repository search. `gh` first: unauthenticated search is rate-limited to
    10/minute per IP and fails opaquely once you cross it."""
    q = urllib.parse.quote(query)
    path = f"search/repositories?q={q}&sort=stars&per_page={limit}"
    if shutil.which("gh"):
        try:
            out = subprocess.run(["gh", "api", path], capture_output=True,
                                 text=True, timeout=25)
            if out.returncode == 0:
                return json.loads(out.stdout)
        except (subprocess.SubprocessError, json.JSONDecodeError):
            pass
    try:
        return get(f"https://api.github.com/{path}")
    except (urllib.error.HTTPError, urllib.error.URLError) as exc:
        print(f"GitHub search failed: {exc}", file=sys.stderr)
        return None


def from_prior_art(theme, limit):
    # GitHub's linguist knows Monkey C, and `language:"Monkey C"` is by far the
    # highest-signal filter available -- ~2600 repositories, essentially all of
    # them Connect IQ. Free-text terms are ANDed against name/description/readme
    # on top of it, so anything specific ("chronograph") routinely returns zero.
    # Fall back to the whole corpus rather than reporting nothing.
    data = gh_search(f'{theme} language:"Monkey C"', limit)
    if data and not data.get("items"):
        print(f'No Monkey C repository mentions "{theme}"; showing the most-starred '
              "Connect IQ projects instead.", file=sys.stderr)
        data = gh_search('language:"Monkey C"', limit)
    if not data:
        return []
    out = []
    for repo in data.get("items", []):
        out.append({
            "repo": repo.get("full_name"),
            "stars": repo.get("stargazers_count"),
            "url": repo.get("html_url"),
            "license": ((repo.get("license") or {}).get("spdx_id")) or "none",
            "description": (repo.get("description") or "")[:110],
        })
    return out


# ----------------------------------------------------------------- report ----

def roles(colours):
    """Suggest palette roles by reflectance, not by hue.

    On a transflective panel brightness IS reflectance, so glance order is a
    luminance ladder. Anything that assigns roles by hue produces a face where
    the fastest-moving element is the dimmest thing on the dial."""
    uniq = sorted({quantize(c["rgb"]) for c in colours}, key=luminance)
    if not uniq:
        return {}
    darkest, brightest = uniq[0], uniq[-1]
    mid = uniq[len(uniq) // 2]
    # An accent must be bright enough to read AND distinguishable from the ink.
    accent = max((c for c in uniq if c not in (darkest, brightest)),
                 key=luminance, default=brightest)
    return {
        "DIAL": darkest,
        "RULE": mid if mid not in (darkest, brightest) else darkest,
        "INDEX": brightest,
        "HAND": brightest,
        "ACCENT": accent,
    }


def report(bundles, art):
    for b in bundles:
        print(f"\n{b['name']}  ({b['source']})")
        print("-" * 62)
        if not b["colours"]:
            print("  no colours returned")
        for c in sorted(b["colours"], key=lambda c: -luminance(quantize(c["rgb"]))):
            src, q = tuple(c["rgb"]), quantize(c["rgb"])
            shift = "" if src == q else f"  <- {hexof(src)} shifted"
            print(f"  {hexof(q)}  lum {luminance(q):>3}  {c['role']}{shift}")
        if b["typefaces"]:
            print(f"  typefaces (tone only, none exist on device): "
                  f"{', '.join(b['typefaces'])}")

    merged = [c for b in bundles for c in b["colours"]]
    if merged:
        print("\nSuggested roles, ordered by reflectance")
        print("-" * 62)
        for role, rgb in roles(merged).items():
            print(f"  {role:<8} {hexof(rgb)}  lum {luminance(rgb)}")
        print("\n  Sanity-check before adopting: DIAL to INDEX should be the "
              "biggest\n  luminance gap you have, and ACCENT must not be the "
              "dimmest colour on\n  the face -- see references/display.md.")

    if art:
        print("\nPrior art on GitHub -- read the source, do not copy it")
        print("-" * 62)
        for r in art:
            print(f"  {r['stars']:>5}*  {r['repo']}  [{r['license']}]")
            if r["description"]:
                print(f"         {r['description']}")
        print("\n  Licences vary and most of these carry none, which means all "
              "rights\n  reserved. Read for technique; write your own code.")


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--brand", metavar="DOMAIN", help="Brandfetch lookup")
    ap.add_argument("--image", metavar="PATH", help="dominant colours from a file")
    ap.add_argument("--colours", type=int, default=6, help="how many from --image")
    ap.add_argument("--prior-art", metavar="THEME", help="search GitHub for faces")
    ap.add_argument("--limit", type=int, default=8, help="prior-art results")
    ap.add_argument("--json", metavar="PATH", help="also write tokens as JSON")
    args = ap.parse_args()

    if not (args.brand or args.image or args.prior_art):
        ap.error("nothing to do: pass --brand, --image and/or --prior-art")

    bundles = []
    if args.brand:
        b = from_brandfetch(args.brand)
        if b:
            bundles.append(b)
    if args.image:
        b = from_image(args.image, args.colours)
        if b:
            bundles.append(b)
    art = from_prior_art(args.prior_art, args.limit) if args.prior_art else []

    if not bundles and not art:
        print("No sources returned anything usable.", file=sys.stderr)
        return 1

    report(bundles, art)

    if args.json:
        merged = [c for b in bundles for c in b["colours"]]
        Path(args.json).write_text(json.dumps({
            "sources": [b["source"] for b in bundles],
            "palette": [hexof(quantize(c["rgb"])) for c in merged],
            "roles": {k: hexof(v) for k, v in roles(merged).items()},
            "priorArt": art,
        }, indent=2) + "\n", encoding="utf-8")
        print(f"\nWrote {args.json}")

    print("\nNext: draw two or three variants as SVG and run ciq-mock on them.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
